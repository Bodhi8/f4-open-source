{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F4 canonical data contract v1",
  "$defs": {
    "Carrier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "onboarded_at": {
          "type": "string",
          "format": "date-time"
        },
        "usdot": {
          "type": "string"
        },
        "mc_number": {
          "type": "string"
        },
        "dba_name": {
          "type": "string"
        },
        "address_hash": {
          "type": "string"
        },
        "contact_hash": {
          "type": "string"
        },
        "authority_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "observed_at",
        "legal_name",
        "onboarded_at"
      ]
    },
    "Debtor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier_hash": {
          "type": "string"
        },
        "days_to_pay": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "observed_at",
        "name"
      ]
    },
    "Invoice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
