        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "paid_at": {
          "type": "string",
          "format": "date-time"
        },
        "remittance_reference": {
          "type": "string"
