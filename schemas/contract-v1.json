          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "fraud_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "propensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "exclusiveMinimum": 0
