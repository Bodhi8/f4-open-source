        "destination": {
          "type": "string",
          "minLength": 1
        },
        "pickup_at": {
          "type": "string",
          "format": "date-time"
        },
        "delivery_at": {
          "type": "string",
          "format": "date-time"
        },
        "rate": {
          "type": "number",
          "minimum": 0
